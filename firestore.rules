rules_version = '2';

// ===============================================================
// CodeVanta Hub - Cloud Firestore Security Rules
// ===============================================================
//
// Assumed Data Models:
//
// Collection: users/{userId}
//   - Document ID: matches Firebase Auth uid
//   - Fields: uid (string), email (string), displayName / fullName (string), photoURL (string),
//             role (string: 'user' | 'member' | 'admin'),
//             planId (string: 'free' | 'starter' | 'basic' | 'pro' | 'vip'),
//             planName (string),
//             membershipId (string), membershipStatus (string),
//             membershipStartsAt (string/timestamp), membershipExpiresAt (string/timestamp/null),
//             membershipReference (string),
//             accountStatus (string: 'active' | 'suspended' | 'pending'),
//             paymentStatus (string: 'unpaid' | 'paid' | 'refunded'),
//             referralCode (string), referredBy (string), referralRewards (number/map),
//             createdAt (timestamp/string), updatedAt (timestamp/string)
//
// Collection: resources/{resourceId}
//   - Fields: name (string), slug (string), published (bool),
//             category_id (string), pricing_classification (string), etc.
//
// Collection: categories/{categoryId}
//   - Fields: name (string), slug (string), description (string), icon (string), display_order (number)
//
// Collection: tutorials/{tutorialId}
//   - Fields: title (string), slug (string), published (bool), content (string), etc.
//
// Collection: plans/{planId}
//   - Fields: name (string), slug (string), price_kes (number), billing_cycle (string), entitlements (map)
//
// Collection: subscriptions/{subId}
//   - Fields: userId (string), planId (string), planName (string), status (string),
//             amount_paid_kes (number), paymentReference (string), startsAt (timestamp), updatedAt (timestamp)
//
// Collection: referrals/{refId}
//   - Fields: referrerId (string), referredId (string), referral_code (string), status (string)
//
// Collection: commissions/{commId}
//   - Fields: userId (string), amount (number), status (string)
//
// Collection: payments/{paymentId}
//   - Fields: id (string), userId (string), planId (string), planName (string),
//             amount_kes (number), currency (string), provider (string),
//             provider_reference (string), phone_number (string), status (string),
//             createdAt (timestamp), updatedAt (timestamp)
//
// Collection: promo_redemptions/{redemptionId}
//   - Fields: userId (string), userEmail (string), code (string), planSlug (string), planName (string), redeemedAt (timestamp)
//
// Collection: bookmarks/{bookmarkId}
//   - Fields: userId (string), resourceId (string), resourceName (string), notes (string)
//
// Collection: auditLogs/{logId}
//   - Fields: admin_user_id (string), action (string), target_entity (string), details (string)
//
// Collection: learning_paths/{pathId}
//   - Fields: title (string), slug (string), published (bool), description (string)
//
// Collection: projects/{projectId}
//   - Fields: title (string), slug (string), published (bool), summary (string)
//
// Collection: troubleshooting/{entryId}
//   - Fields: error_message (string), slug (string), published (bool), step_by_step_fix (string)
//
// Collection: resource_submissions/{submissionId}
//   - Fields: submitted_by (string), resource_name (string), status (string)
//
// Collection: withdrawals/{withdrawalId}
//   - Fields: userId (string), amount_kes (number), status (string)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the designated document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user possesses admin privileges via bootstrap verified email or custom token claims
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'joshkigs8@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Check if the user's email address is verified or user has admin privileges
    function isEmailVerified() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true ||
        isAdmin()
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Users Collection
    // Read: Owner or Admin only (PII protected; Admin has full list & read access)
    // Create: Admin or Owner on initial signup; unverified users can bootstrap profile without privileged roles/plans/fields.
    //         Designated root admin (joshkigs8@gmail.com) can be initialized as admin; regular users default to 'user' and 'free'.
    // Update: Admin has full write access; Verified owner can ONLY update their own designated safe profile fields.
    //         Strictly prohibits non-admin users from modifying planId, planName, role, membership*, accountStatus, paymentStatus.
    //         Immutable fields (uid, email, createdAt, referralCode, referredBy, referralRewards) remain strictly immutable.
    // Delete: Admin only
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isAdmin() || (
        isAuthenticated() &&
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        (
          (request.auth.token.email == 'joshkigs8@gmail.com' && (!('role' in request.resource.data) || request.resource.data.role in ['user', 'admin'])) ||
          (!('role' in request.resource.data) || request.resource.data.role == 'user')
        ) &&
        (!('planId' in request.resource.data) || request.resource.data.planId == 'free') &&
        (!('planName' in request.resource.data) || request.resource.data.planName in ['Free Tier', 'Free', 'free']) &&
        (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'unpaid') &&
        (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus in ['active', 'pending']) &&
        !('referralRewards' in request.resource.data) &&
        !('membershipId' in request.resource.data) &&
        !('membershipStatus' in request.resource.data) &&
        !('membershipStartsAt' in request.resource.data) &&
        !('membershipExpiresAt' in request.resource.data) &&
        !('membershipReference' in request.resource.data)
      );
                    
      allow update: if isAdmin() || (
        isOwner(userId) &&
        isEmailVerified() &&
        // Strictly prohibit non-admin modification of any privilege, membership, or payment fields
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'planId', 'planName', 'role',
          'membershipId', 'membershipStatus', 'membershipStartsAt', 'membershipExpiresAt', 'membershipReference',
          'accountStatus', 'paymentStatus',
          'uid', 'email', 'createdAt', 'referralCode', 'referredBy', 'referralRewards'
        ]) &&
        // Regular verified users may ONLY update safe profile fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'fullName', 'photoURL', 'phoneNumber', 'country', 'updatedAt', 'emailVerified'
        ]) &&
        // Guarantee immutable fields preserve their exact original values
        request.resource.data.uid == resource.data.uid &&
        (!('email' in request.resource.data) || request.resource.data.email == resource.data.email) &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        (!('referralCode' in request.resource.data) || request.resource.data.referralCode == resource.data.referralCode) &&
        (!('referredBy' in request.resource.data) || request.resource.data.referredBy == resource.data.referredBy) &&
        // Input sanitization and DoS / Resource Exhaustion limits on safe profile fields
        (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100)) &&
        (!('fullName' in request.resource.data) || (request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100)) &&
        (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000)) &&
        (!('phoneNumber' in request.resource.data) || request.resource.data.phoneNumber == null || (request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 30)) &&
        (!('country' in request.resource.data) || (request.resource.data.country is string && request.resource.data.country.size() <= 10)) &&
        (!('emailVerified' in request.resource.data) || request.resource.data.emailVerified is bool)
      );
                        
      allow delete: if isAdmin();
    }

    // 2. Resources Collection
    // Read: Publicly readable if published == true; Admin can list/read all (published & drafts)
    // Create: Strictly admin, or verified users submitting unpublished proposal drafts
    // Update / Delete: Strictly admin-only
    match /resources/{resourceId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() || (isEmailVerified() && request.resource.data.published == false);
      allow update, delete: if isAdmin();
    }

    // 3. Categories Collection
    // Read: Public directory categorization
    // Write: Strictly admin-only
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Tutorials Collection
    // Read: Publicly readable if published == true; Admin can list/read all (published & drafts)
    // Write: Strictly admin-only
    match /tutorials/{tutorialId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 5. Membership Plans Collection
    // Read: Publicly viewable pricing tiers and entitlements
    // Write: Strictly admin-only
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Subscriptions Collection
    // Read: Subscriber (owner) or Admin (Admin has full list & read access across all subscriptions)
    // Create: Authenticated owner or Admin (allows client flows to record subscription activations)
    // Update / Delete: Admin only
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 7. Referrals Collection
    // Read: Referrer, referred user, or Admin (Admin has full list & read access)
    // Create: Admin, or authenticated & email-verified referred user attributing themselves to a distinct referrer
    // Update / Delete: Strictly admin-only
    match /referrals/{refId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referredId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isEmailVerified() &&
        request.resource.data.referredId == request.auth.uid &&
        request.resource.data.referrerId != request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // 8. Commissions Collection
    // Read: Owning user or Admin (Admin has full list & read access)
    // Write: Admin only (zero client-side writes allowed)
    match /commissions/{commId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 9. Payments Collection
    // Read: Owning user or Admin (Admin has full list & read access across all payments)
    // Create: Authenticated owner or Admin (allows client flows to record payment confirmations)
    // Update / Delete: Admin only
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 10. Promo Code Redemptions Collection
    // Read: Owning user or Admin
    // Create: Authenticated user creating their own redemption record
    // Update / Delete: Admin only
    match /promo_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 11. Bookmarks Collection
    // Read: Owning user or Admin (Admin has full list & read access)
    // Create: Owning verified user or Admin
    // Update: Owning verified user without ownership hijacking or Admin
    // Delete: Owning verified user or Admin
    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isOwner(request.resource.data.userId) && isEmailVerified());
      allow update: if isAdmin() || (isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && isEmailVerified());
      allow delete: if isAdmin() || (isOwner(resource.data.userId) && isEmailVerified());
    }

    // 12. Audit Logs Collection
    // Read & Write: Strictly admin-only (Admin has full list, read, and write permissions)
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 13. Learning Paths Collection
    // Read: Publicly readable if published == true; Admin can list/read all
    // Write: Strictly admin-only
    match /learning_paths/{pathId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 14. Guided Projects Collection
    // Read: Publicly readable if published == true; Admin can list/read all
    // Write: Strictly admin-only
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 15. Troubleshooting Entries Collection
    // Read: Publicly readable if published == true; Admin can list/read all
    // Write: Strictly admin-only
    match /troubleshooting/{entryId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 16. Resource Submissions Collection
    // Read: Submitting user or Admin
    // Create: Verified user submitting for themselves or Admin
    // Update / Delete: Strictly admin-only
    match /resource_submissions/{submissionId} {
      allow read: if (isAuthenticated() && resource.data.submitted_by == request.auth.uid) || isAdmin();
      allow create: if isAdmin() || (isEmailVerified() && request.resource.data.submitted_by == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 17. Withdrawal Requests Collection
    // Read: Requesting user or Admin
    // Create: Verified user submitting for themselves or Admin
    // Update / Delete: Strictly admin-only
    match /withdrawals/{withdrawalId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin() || (isEmailVerified() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Default Deny Rule
    // ===============================================================
    // Any unspecified collection or document path is closed to all reads and writes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
