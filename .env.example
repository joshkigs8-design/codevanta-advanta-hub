# -------------------------------------------------------------
# CODEVANTA ADVANTA HUB — ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CodeVanta Advanta Hub"
NEXT_PUBLIC_OPERATOR="CodeVanta Ventures"

# Security & Session Authentication
# Generate a strong 32+ character random string for production
JWT_SECRET=super-secret-development-key-change-in-production-min32chars
SESSION_COOKIE_NAME=cv_hub_session

# Database Configuration
# Local SQLite fallback is active by default (zero cloud setup required).
# To connect to production Supabase PostgreSQL, uncomment and set the credentials below:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Referral & Compliance Program Settings
# Valid modes: 'compliance_review' (DEFAULT - real payouts locked), 'approved_for_launch', 'disabled', 'suspended'
REFERRAL_PROGRAM_STATUS=compliance_review
MINIMUM_WITHDRAWAL_KES=100
DEFAULT_PAYOUT_FEE_KES=0

# Payment Gateway Configuration (M-Pesa Daraja / Kenyan Gateway)
# Sandbox mock mode enabled by default
PAYMENT_GATEWAY_MODE=sandbox
MPESA_CONSUMER_KEY=mock_consumer_key_sandbox
MPESA_CONSUMER_SECRET=mock_consumer_secret_sandbox
MPESA_PASSKEY=mock_passkey_sandbox
MPESA_SHORTCODE=174379
MPESA_CALLBACK_SECRET=mock_webhook_signature_secret_sandbox

# Initial Admin Seed Credentials
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=your_admin_password_here

# Groq Chatbot
# Keep this server-side key private; never expose it as NEXT_PUBLIC_GROQ_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Firebase Web Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
